# /srv/llm-gateway/.env — ключи llm-gateway. Права 0600.
# Цены и лимиты — не здесь, а в stacks/platform/config/llm-gateway.yaml.

# Настоящий ключ Gemini из AI Studio. Есть только у шлюза, боты его не знают.
GEMINI_API_KEY=

# Ключи клиентов: LLM_KEY_<ИМЯ СЕРВИСА большими буквами, дефис как _>. Не короче 16 символов.
# Записывает их install.sh llm-key <svc> вместе с ключом в .env сервиса; руками — openssl rand -hex 24.
# LLM_KEY_BUDGET_BOT=
# LLM_KEY_WELLBEING_BOT=
# LLM_KEY_NUTRITION_ASSISTANT=
