# /srv/secrets/wellbeing-bot.env — секреты и настройки wellbeing-bot. Права 0600, правится в панели («Сейф»).
# BOT_DB задаётся в compose (/data/wellbeing.db), здесь его не указывать.

# Токен из BotFather. Обязателен.
BOT_TOKEN=

# Telegram ID администратора. Обязателен.
ADMIN_ID=

# Таймзона: от неё считается «сегодня» и время напоминаний.
BOT_TIMEZONE=Asia/Bishkek

# Сколько пользователей бот принимает.
MAX_USERS=10

# Ключ и адрес Gemini. При установке update.sh сам пишет сюда ключ шлюза и GEMINI_BASE_URL=http://llm-gateway:8080.
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=gemini-3.8-flash
