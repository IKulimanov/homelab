# /srv/wellbeing-bot/.env — секреты и настройки wellbeing-bot. Права 0600.
# BOT_DB задаётся в compose (/data/wellbeing.db), здесь его не указывать.

# Токен из BotFather. Обязателен.
BOT_TOKEN=

# Telegram ID администратора.
ADMIN_ID=

# Таймзона: от неё считается «сегодня» и время напоминаний.
BOT_TIMEZONE=Asia/Bishkek

# Сколько пользователей бот принимает.
MAX_USERS=10

# Ключ и адрес Gemini. До переключения на шлюз — настоящий ключ, GEMINI_BASE_URL пустой (адрес Google).
# После install.sh llm-key wellbeing-bot здесь ключ шлюза и GEMINI_BASE_URL=http://llm-gateway:8080.
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=gemini-3.8-flash
