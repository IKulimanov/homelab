# /srv/secrets/ops-bot.env — ключ для комментария Бендера к недельному отчёту. Права 0600.
# GEMINI_API_KEY и GEMINI_BASE_URL пишет update.sh при установке (или install.sh llm-key ops-bot).
# Пустой ключ — отчёт с готовой фразой. Токен и chat id бота — в homelab.env.
GEMINI_API_KEY=
GEMINI_BASE_URL=
OPS_LLM_MODEL=gemini-2.5-flash
