# /srv/nutrition-assistant/.env — секреты nutrition-assistant. Права 0600.
# Остальные настройки — в /srv/nutrition-assistant/config.yaml (его создаёт install.sh service nutrition-assistant).

# Токен из BotFather. Обязателен.
TELEGRAM_BOT_TOKEN=

# Ключ Gemini. До переключения на шлюз — настоящий ключ. После install.sh llm-key nutrition-assistant —
# ключ шлюза, а адрес шлюза записан в config.yaml, gemini.base_url.
GEMINI_API_KEY=

# Нужен, только если в config.yaml в models есть модели claude-*. Идёт в Anthropic напрямую, без шлюза.
ANTHROPIC_API_KEY=

# Распознавание голосовых. Без ключа голосовые не принимаются.
OPENAI_API_KEY=
