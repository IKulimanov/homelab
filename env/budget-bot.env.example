# /srv/secrets/budget-bot.env — секреты и настройки budget-bot. Права 0600, правится в панели («Сейф»).
# BOT_DB задаётся в compose (/data/budget.db), здесь его не указывать.

# Токен из BotFather. Обязателен.
BOT_TOKEN=

# Таймзона пространства: от неё считается «сегодня» и время напоминания.
BOT_TIMEZONE=Asia/Bishkek

# Время вечернего напоминания по умолчанию.
BOT_REMINDER_TIME=21:00

# Ключ и адрес Gemini. Без ключа отчёт за месяц уходит без категорий и советов.
# До переключения на шлюз — настоящий ключ, GEMINI_BASE_URL пустой (адрес Google).
# После install.sh llm-key budget-bot здесь ключ шлюза и GEMINI_BASE_URL=http://llm-gateway:8080.
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=gemini-2.5-flash
