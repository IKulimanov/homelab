# /srv/budget-bot/.env — секреты и настройки budget-bot. Права 0600.
# BOT_DB задаётся в compose (/data/budget.db), здесь его не указывать.

# Токен из BotFather. Обязателен.
BOT_TOKEN=

# Таймзона пространства: от неё считается «сегодня» и время напоминания.
BOT_TIMEZONE=Asia/Bishkek

# Время вечернего напоминания по умолчанию.
BOT_REMINDER_TIME=21:00

# Ключ Gemini. Без него отчёт за месяц уходит без категорий и советов.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
