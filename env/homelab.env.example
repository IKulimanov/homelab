# /opt/homelab/.env — общие настройки homelab. Права 0600, в git не попадает.

# Служебный бот: сюда приходят уведомления об обновлениях, бэкапах и алерты.
# Токен — от @BotFather, chat id — твой Telegram ID.
OPS_BOT_TOKEN=
OPS_CHAT_ID=

# Часовой пояс ops-bot и llm-gateway: по нему отчёт в 23:55 и граница месяца для лимитов LLM.
TZ=Asia/Bishkek

# Диски, место на которых проверяет ops-bot (пути хоста через запятую).
OPS_DISKS=/,/data,/mnt/backup

# Необязательно: адрес пинга healthchecks.io. Если сервер или Docker упадут, придёт письмо или сообщение оттуда.
HEALTHCHECK_URL=

# Заполняет install.sh: группа docker хоста (для доступа ops-bot к docker.sock) и общий токен ops-bot и llm-gateway.
DOCKER_GID=
LLM_ADMIN_TOKEN=

# Копии баз. Без смонтированного тома копии не делаются: копия на том же диске не спасает от его потери.
BACKUP_ROOT=/mnt/backup
BACKUP_KEEP_DAYS=30
BACKUP_REQUIRE_MOUNT=yes

# Закреплённые версии для отката. Пусто — последняя сборка из main.
# Пример: BUDGET_BOT_TAG=sha-2740b45
BUDGET_BOT_TAG=
WELLBEING_BOT_TAG=
NUTRITION_ASSISTANT_TAG=
OPS_BOT_TAG=
LLM_GATEWAY_TAG=
